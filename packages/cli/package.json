{
  "name": "@adr-tool/cli",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The command line of Softarch Suite: `adr lint` checks the Decision Logs of a repository and `adr check` its Rules and its Diagrams against the code, for CI; `adr export` writes the Decision Logs as HTML pages. It also holds the one way the suite runs git, which the app uses too",
  "type": "module",
  "bin": {
    "adr": "./dist/adr.mjs"
  },
  "exports": {
    "./analysis": "./src/analysis.ts",
    "./annotations": "./src/annotations.ts",
    "./conformance": "./src/conformance.ts",
    "./export": "./src/export.ts",
    "./git": "./src/git.ts",
    "./listing": "./src/listing.ts",
    "./tree-sitter-wasm": "./src/tree-sitter-wasm.ts"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@adr-tool/assessment": "workspace:*",
    "@adr-tool/conformance": "workspace:*",
    "@adr-tool/core": "workspace:*",
    "@adr-tool/diagrams": "workspace:*",
    "@adr-tool/kernel": "workspace:*",
    "@adr-tool/review": "workspace:*",
    "@adr-tool/structure": "workspace:*",
    "@types/node": "^24.13.5",
    "ignore": "^7.0.9",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "0.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "web-tree-sitter": "^0.27.0"
  }
}
