  "devDependencies": {
    "@adr-tool/cli": "workspace:*",
    "@adr-tool/core": "workspace:*",
    "@adr-tool/review": "workspace:*",
    "@adr-tool/structure": "workspace:*",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
