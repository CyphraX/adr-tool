{
  "name": "@adr-tool/app",
  "version": "0.0.0",
  "private": true,
  "description": "The ADR Tool desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@adr-tool/core": "workspace:*",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.13.5",
    "electron": "^44.4.1",
    "electron-vite": "^5.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
