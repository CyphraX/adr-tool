<?xml version="1.0" encoding="UTF-8"?>
<!-- A multi-module Maven project to look at in the app's Structure view (README.md,
     "Development"): a package spread over two modules, on-demand imports, a duplicate
     simple name. Nothing here is ever built. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.shop</groupId>
  <artifactId>shop</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>
  <modules>
    <module>catalog</module>
    <module>cart</module>
    <module>web</module>
  </modules>
</project>
