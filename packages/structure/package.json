{
  "name": "@adr-tool/structure",
  "version": "0.0.0",
  "private": true,
  "description": "The UI-free core of the Structure module: Components, Source Files, Dependencies. No Electron, no DOM, no disk access of its own",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model.ts"
  },
