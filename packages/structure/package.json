  },
  "dependencies": {
    "@adr-tool/kernel": "workspace:*",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "vitest": "^5.0.1"
  }
}
