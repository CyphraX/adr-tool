{
  "name": "@adr-tool/diagrams",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "The UI-free core of the Diagrams module: Diagrams bound to Structure's Components, their Drift, and their SVG. No Electron, no DOM, no disk access of its own",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "export-own": "vitest run --mode export test/own-repository.test.ts"
  },
  "dependencies": {
    "@adr-tool/kernel": "workspace:*",
    "@adr-tool/structure": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
